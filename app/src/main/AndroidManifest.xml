<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The renderer is Dawn on Vulkan. -->
    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- LAN play: UDP between devices, and a multicast lock so the Wi-Fi driver hands the app the
         broadcast packets rooms are discovered with. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Check for Updates / Auto Update: hands the release's APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The game file browser (FileBrowser) lists the phone's folders. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:isGame="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <provider
            android:name=".LogShareProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The game runs in its own process: the native runtime is built to start once per
             process, so leaving the game always ends that process and the next start is fresh. -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:process=":game"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:preferMinimalPostProcessing="true"
            android:theme="@style/GameTheme"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />

        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
